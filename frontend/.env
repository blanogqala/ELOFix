# Backend API (must match your deployed API; include /api)
VITE_API_BASE_URL=http://localhost:5000/api
# Same host as above, without /api — used for /uploads image URLs
VITE_API_ORIGIN=http://localhost:5000
# Optional explicit Socket.IO origin (recommended in production)
# Example: https://api.yourdomain.com
VITE_SOCKET_URL=
VITE_GOOGLE_MAPS_API_KEY=AIzaSyC0kfNkOdc6Na87FPYjUgZlHGkgI1WJW6w
# Public frontend URL (must match FRONTEND_URL on the backend for Google OAuth redirects)
# Local: http://localhost:8080
# Production: https://YOUR-NETLIFY-SITE.netlify.app
VITE_FRONTEND_URL=http://localhost:8080

# Set to true to enable Firebase Auth + backend session/profile
VITE_USE_FIREBASE=false

# Set to false to allow registration acceptance without scrolling legal pages first
# VITE_LEGAL_REQUIRE_SCROLL=false