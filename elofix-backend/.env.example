# Local PostgreSQL (no SSL) — avoids "sslmode" mismatch warnings with default local installs
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/elofix?schema=public&sslmode=disable"

# Hosted PostgreSQL (e.g. Neon, Supabase, RDS) — require TLS; use verify-full if you have CA bundle
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/elofix?schema=public&sslmode=require"

# If the URL cannot include sslmode, you can force pool SSL instead:
# DATABASE_SSL=true
# DATABASE_SSL_REJECT_UNAUTHORIZED=false

# Disable SSL explicitly when your provider string implies SSL but the server is local:
# DATABASE_SSL_DISABLE=true

JWT_SECRET="change-me-in-production"
PORT=5000
JWT_EXPIRES_IN=7d
ADMIN_EMAIL="admin@elofix.com"
ADMIN_PASSWORD="Admin@123"
ADMIN_NAME="ELOFix Admin"

# Optional pool tuning
# PG_POOL_MAX=10
# PG_CONNECTION_TIMEOUT_MS=10000
# PG_IDLE_TIMEOUT_MS=30000

# PRISMA_LOG_QUERIES=1

# --- DB migrations (run from elofix-backend/) ---
# npx prisma migrate deploy
# npx prisma generate
# Optional: import legacy data/app-state.json → Postgres
# node scripts/migrate-app-state-from-json.js
