# PostgreSQL URL. Production: unchanged. Development: localhost gets sslmode=disable automatically; remote (Neon, etc.)
# keeps your URL — add ?sslmode=require if the host requires TLS. Optional: DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/elofix?schema=public&sslmode=disable"

# Optional (NODE_ENV=development only): use a local URL while DATABASE_URL points elsewhere
# LOCAL_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/elofix?schema=public"

# Hosted PostgreSQL (e.g. Neon, Supabase, RDS) — require TLS; use verify-full if you have CA bundle
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/elofix?schema=public&sslmode=require"

# If the URL cannot include sslmode, you can force pool SSL instead:
# DATABASE_SSL=true
# DATABASE_SSL_REJECT_UNAUTHORIZED=false

# Disable SSL explicitly when your provider string implies SSL but the server is local:
# DATABASE_SSL_DISABLE=true

# Upload storage root (default: elofix-backend/uploads). On Render with persistent disk:
# UPLOAD_ROOT=/opt/render/project/src/uploads

# --- Object storage (Cloudflare R2 / AWS S3) — recommended for Render Free tier ---
# When set, uploads are mirrored to the bucket and served from there if local disk is empty.
# S3_BUCKET=elofix-uploads
# S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto
# S3_PUBLIC_URL=https://pub-xxx.r2.dev

# Optional malware scanning for uploads (requires clamscan or FILE_SCAN_COMMAND on PATH)
# FILE_SCAN_ENABLED=true
# FILE_SCAN_COMMAND=clamscan
# FILE_SCAN_TIMEOUT_MS=120000

# Signed URL TTL (seconds) for protected provider documents in API responses
# FILE_ACCESS_TTL_SECONDS=3600
# FILE_ACCESS_SECRET=optional-separate-secret

# Upload rate limit fraud alerts (blocks in lookback window before admin alert)
# UPLOAD_RATE_VIOLATION_ALERT_THRESHOLD=3
# UPLOAD_RATE_VIOLATION_LOOKBACK_HOURS=24

# Google OAuth 2.0 (https://console.cloud.google.com/)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Must match an Authorized redirect URI in Google Cloud Console
# Local: http://localhost:5000/api/auth/google/callback
# Production: https://YOUR-RENDER-API.onrender.com/api/auth/google/callback
GOOGLE_CALLBACK_URL="http://localhost:5000/api/auth/google/callback"
# Frontend origin used after Google sign-in (Netlify URL in production)
FRONTEND_URL="http://localhost:8080"
# Optional comma-separated extra browser origins for CORS / Socket.IO
# CORS_ALLOWED_ORIGINS="https://staging.example.com"

# Password reset emails (https://resend.com)
# If Resend verified send.yourdomain.co.za, use noreply@send.yourdomain.co.za here
RESEND_API_KEY=
EMAIL_FROM="EloFix <noreply@send.yourdomain.co.za>"

# Legal document versions (must match frontend/src/lib/legal/versions.ts)
# LEGAL_TERMS_VERSION=2026-05-01
# LEGAL_PRIVACY_VERSION=2026-05-01
# LEGAL_PROVIDER_AGREEMENT_VERSION=2026-05-01
# LEGAL_REFUND_POLICY_VERSION=2026-05-01

# Optional: used to derive callback URL when GOOGLE_CALLBACK_URL is unset
# API_BASE_URL="http://localhost:5000/api"

# AES encryption for provider bank fields (account number, branch). Min 8 characters; use a long random string in production.
SECRET_KEY="change-me-bank-encryption-key"
# Salt for scrypt key derivation (Node crypto) when encrypting bank fields (v2). Min 8 characters; keep stable per environment.
BANK_KDF_SALT="change-me-bank-kdf-salt"
# Pre-launch only: allow hosted testing without real secrets (profile save, document hashing). Remove before go-live.
# ELOFIX_TESTING_MODE=true
# New encrypt defaults: v2 (Node crypto). Use v1 only for legacy compatibility.
ENCRYPTION_VERSION=v2
PORT=5000
JWT_EXPIRES_IN=7d
ADMIN_EMAIL="admin@elofix.com"
ADMIN_PASSWORD="Admin@123"
ADMIN_NAME="ELOFix Admin"

# Optional pool tuning
# PG_POOL_MAX=10
# PG_CONNECTION_TIMEOUT_MS=10000
# PG_IDLE_TIMEOUT_MS=30000

# PRISMA_LOG_QUERIES=1
# Development only: skip the stuck-withdrawal sweeper (ignored when NODE_ENV=production).
# DISABLE_STUCK_WITHDRAWAL_CRON=true

# --- DB migrations (run from elofix-backend/) ---
# Local: npm run prisma:migrate  (migrate dev; blocked if NODE_ENV=production)
# Local schema sync (dev only, requires NODE_ENV=development): npm run prisma:db-push
# Production: npm run prisma:deploy && npm run prisma:generate
# npx prisma generate
# Optional: import legacy data/app-state.json → Postgres
# node scripts/migrate-app-state-from-json.js

# --- Multi-gateway payments (ZAR) ---
PAYMENT_CURRENCY=ZAR
PAYMENT_BASE_URL=http://localhost:5000
FRONTEND_BASE_URL=http://localhost:5173
ENABLED_PAYMENT_PROVIDERS=payfast,payflex,payjustnow
ALLOW_ADMIN_PAYMENT_OVERRIDE=false

# PayFast (https://developers.payfast.co.za/)
# Shared sandbox merchant 10000100 / 46f0cd694581a: leave PASSPHRASE empty (do not use jt7NOE43FZPn).
# Own sandbox/live account: set PASSPHRASE to the Salt Passphrase from PayFast Settings.
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_MODE=sandbox
# Local dev: settle on return is automatic when NODE_ENV !== production.
# Render/hosted sandbox: set true so /payments/return confirms without waiting for ITN.
# PAYFAST_SETTLE_ON_RETURN=true
# PAYFAST_SKIP_IP_CHECK=true
# PAYFAST_NOTIFY_URL=http://localhost:5000/api/payments/webhooks/payfast

# Payflex (https://docs.payflex.co.za/)
PAYFLEX_CLIENT_ID=
PAYFLEX_CLIENT_SECRET=
PAYFLEX_MODE=sandbox
PAYFLEX_WEBHOOK_SECRET=

# PayJustNow
PAYJUSTNOW_MERCHANT_KEY=
PAYJUSTNOW_MODE=sandbox
PAYJUSTNOW_WEBHOOK_SECRET=

# Reverse geocoding (service request "Use current location"). Preferred: OpenCage; Nominatim used if unset or after OpenCage failure.
# https://opencagedata.com/api
# OPENCAGE_API_KEY=
# Optional: for Nominatim usage policy https://operations.osmfoundation.org/policies/nominatim/
# GEOCODE_USER_AGENT=ELOFix/1.0
# GEOCODE_CONTACT_EMAIL=you@example.com
# GEOCODE_FETCH_TIMEOUT_MS=20000

# OpenRouteService driving directions (backend proxy — keep key server-side only)
# https://openrouteservice.org/dev/#/signup
# OPENROUTESERVICE_API_KEY=
# ROUTING_FETCH_TIMEOUT_MS=15000
# ROUTING_CACHE_TTL_MS=120000
