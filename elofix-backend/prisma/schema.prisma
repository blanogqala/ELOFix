generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  PROVIDER
  ADMIN
  SUPPLIER
}

enum MaterialFulfillmentStatus {
  PENDING
  ACCEPTED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  COMPLETED
  FAILED
  DELAYED
  CANCELLED
}

enum JobStatus {
  PENDING
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum CategoryStep3Type {
  measurements
  items
  issue
}

enum SuggestionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MaterialRequestStatus {
  draft
  submitted
  paid
}

enum BranchUserRole {
  MANAGER
  STAFF
}

enum NotificationCategory {
  ORDERS
  DELIVERY
  INVENTORY
  SYSTEM
  REFUNDS
  STAFF
}

model User {
  id                  String               @id @default(uuid())
  email               String               @unique
  password            String
  name                String
  phone               String?
  profileImage        String?
  role                Role
  createdAt           DateTime             @default(now())
  providerProfile     Provider?
  jobsAsCustomer      Job[]                @relation("JobCustomer")
  jobsAsProvider      Job[]                @relation("JobProvider")
  categorySuggestions CategorySuggestion[]
  notifications       Notification[]
  savedCards          SavedCard[]
  invoices            Invoice[]
  sentNotifications   Notification[]       @relation("NotificationSender")
  auditLogs           AuditLog[]
  supplierProfile     Supplier?
}

model Provider {
  id                String    @id @default(uuid())
  userId            String    @unique
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills            String[]
  location          String    @default("UNKNOWN")
  bio               String?
  /// Whole-job totals (Rand) provider reports or system expands from paid labor on jobs
  lowestPaidJobRand  Decimal?  @db.Decimal(12, 2)
  highestPaidJobRand Decimal?  @db.Decimal(12, 2)
  /// Courier / delivery: rate charged per kilometer (Rand). Distance billing comes later.
  deliveryRatePerKmRand Decimal? @db.Decimal(12, 2)
  /// Combined average: job reviews + material-order delivery ratings (see providerAggregateRating sync)
  rating            Float     @default(0)
  totalReviews      Int       @default(0)
  approved          Boolean   @default(false)
  profileCompleted  Boolean   @default(false)
  onboardingStep    Int?
  businessName      String?
  serviceAreas      String[]  @default([])
  laborPricing      Json?
  documents         Json?
  settings          Json?
  portfolioImages   String[]  @default([])
  profileImage      String?
  blocked           Boolean   @default(false)
  rejectionReason   String?
  rejectedAt        DateTime?
  deletedAt         DateTime?
  reviewSubmittedAt DateTime?

  workPosts              WorkPost[]
  withdrawalProfile      ProviderWithdrawalProfile?
  withdrawalRequests     WithdrawalRequest[]
  categorySuggestions    CategorySuggestion[]    @relation("ProviderCategorySuggestions")
  earnings               Earning[]
  materialOrderRatings   MaterialOrderRating[]
}

model WorkPost {
  id          String   @id @default(uuid())
  providerId  String
  provider    Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  categoryId  String
  title       String
  description String
  images      String[] @default([])
  createdAt   DateTime @default(now())

  @@index([providerId])
}

model CategorySuggestion {
  id         String           @id @default(uuid())
  name       String
  description String?
  icon       String?
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerId String?
  provider   Provider?        @relation("ProviderCategorySuggestions", fields: [providerId], references: [id], onDelete: SetNull)
  status     SuggestionStatus @default(PENDING)
  createdAt  DateTime         @default(now())
  approvedAt DateTime?
  approvedCategoryId String?

  @@index([userId])
  @@index([status])
  @@index([providerId])
  @@index([providerId, status])
  @@index([createdAt])
}

model Job {
  id              String    @id @default(uuid())
  title           String
  category        String    @default("GENERAL")
  location        String    @default("UNKNOWN")
  locationDetails Json?
  description     String
  status          JobStatus @default(PENDING)
  price           Decimal   @db.Decimal(10, 2)
  images          String[]  @default([])
  measurements    Json?
  materials       Json?
  width           Float?
  height          Float?
  length          Float?
  area            Float?
  customerId      String
  customer        User      @relation("JobCustomer", fields: [customerId], references: [id], onDelete: Cascade)
  providerId      String?
  provider        User?     @relation("JobProvider", fields: [providerId], references: [id], onDelete: SetNull)
  createdAt                        DateTime          @default(now())
  meta                             Json?
  laborPaid                        Boolean           @default(false)
  paymentReleased                  Boolean           @default(false)
  /// Gross labor amount charged to customer (at settlement)
  totalPrice                       Decimal?          @db.Decimal(10, 2)
  /// Provider's share (93% of total after 7% commission; half released immediately, half on completion)
  providerAmount                   Decimal?          @db.Decimal(10, 2)
  /// Platform commission (7% of totalPrice)
  commissionAmount                 Decimal           @default(0) @db.Decimal(10, 2)
  /// Cumulative amount released to provider (not including commission)
  releasedAmount                   Decimal           @default(0) @db.Decimal(10, 2)
  isFullyReleased                  Boolean           @default(false)
  /// Prevents double second-tranche release on confirm-completion
  escrowSecondReleaseDone          Boolean           @default(false)
  review                           Review?
  earnings                         Earning[]
  commissionLedger                 CommissionLedger?
  paystackCharges                  PaystackCharge[]
  materialRequests                 MaterialRequest[]
  purchaseMaterialOrders           MaterialOrder[] @relation("JobMaterialOrders")
}

model MaterialRequest {
  id          String                  @id @default(uuid())
  jobId       String
  job         Job                     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  providerId  String
  customerId  String
  items       Json
  totalAmount Decimal                 @db.Decimal(12, 2)
  status      MaterialRequestStatus   @default(draft)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  @@index([jobId])
  @@index([providerId])
  @@index([status])
  @@index([jobId, status])
  @@index([customerId])
}

/// One row per job after successful labor payment — admin aggregation
model CommissionLedger {
  id         String   @id @default(uuid())
  jobId      String   @unique
  job        Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  amount     Decimal  @db.Decimal(12, 2)
  source     String   @default("labor_payment")
  /// Full gross (customer payment) for reporting
  totalPrice Decimal? @db.Decimal(12, 2)
  currency   String?  @default("NGN")
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

/// Paystack init / verify state per job+reference
model PaystackCharge {
  id                 String   @id @default(uuid())
  jobId              String
  job                Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  paystackReference  String   @unique
  status             String   @default("pending")
  /// Amount in minor unit currency (ZAR/NGN per Paystack)
  amountZar          Decimal  @default(0) @db.Decimal(12, 2)
  refundedZar        Decimal  @default(0) @db.Decimal(12, 2)
  paystackTransId    String?
  lastRefundMeta     Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([jobId])
  @@index([status])
}

/// Processed Paystack webhook events (idempotency; eventId = Paystack `data.id`)
model PaystackWebhookEvent {
  id        String   @id @default(uuid())
  eventId   String   @unique
  createdAt DateTime @default(now())
}

model Conversation {
  id                String         @id @default(uuid())
  senderId          String
  jobId             String?
  conversationType  String         @default("job")
  createdAt         DateTime       @default(now())
  notifications     Notification[]

  @@index([senderId])
  @@index([jobId])
  @@index([conversationType])
}

model Earning {
  id                    String             @id @default(uuid())
  providerId            String
  provider              Provider           @relation(fields: [providerId], references: [id], onDelete: Cascade)
  jobId                 String?
  job                   Job?               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  amount                Decimal            @db.Decimal(12, 2)
  type                  String
  status                String
  idempotencyKey        String?            @unique
  withdrawalRequestId   String?            @unique
  withdrawalRequest     WithdrawalRequest? @relation(fields: [withdrawalRequestId], references: [id], onDelete: SetNull)
  createdAt             DateTime           @default(now())

  @@index([providerId])
  @@index([jobId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
}

model Category {
  id                 String            @id
  name               String            @unique
  icon               String
  description        String
  requiresMaterials  Boolean           @default(false)
  requiresInspection Boolean           @default(true)
  skills             String[]
  step3Type          CategoryStep3Type
  issueTypes         String[]
  commonItems        Json?
  isActive           Boolean           @default(true)
  sortOrder          Int               @default(0)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
}

model Notification {
  id              String        @id @default(uuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  senderId        String?
  sender          User?         @relation("NotificationSender", fields: [senderId], references: [id], onDelete: SetNull)
  senderName      String?
  senderRole      String?
  type            String
  title           String
  message         String
  read            Boolean       @default(false)
  jobId           String?
  /** Store material-order id for supplier portal notifications (distinct from Job). */
  materialOrderId String?
  conversationId  String?
  conversation    Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  notificationCategory NotificationCategory @default(SYSTEM)
  createdAt       DateTime      @default(now())

  @@index([userId])
  @@index([userId, createdAt])
  @@index([senderId])
  @@index([conversationId])
  @@index([notificationCategory])
}

model Review {
  id        String   @id @default(uuid())
  jobId     String   @unique
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  @@index([jobId])
}

model ProviderWithdrawalProfile {
  id             String   @id @default(uuid())
  providerId     String   @unique
  provider       Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  bankName       String
  accountNumber  String
  accountHolder  String
  branchCode     String
  updatedAt      DateTime @updatedAt
}

model WithdrawalRequest {
  id               String    @id @default(uuid())
  providerId       String
  provider         Provider  @relation(fields: [providerId], references: [id], onDelete: Cascade)
  amount           Decimal   @db.Decimal(12, 2)
  status           String    @default("pending")
  idempotencyKey   String?   @unique
  createdAt        DateTime  @default(now())
  debitEarning     Earning?

  @@index([providerId])
  @@index([status])
  @@index([createdAt])
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model IdempotencyRecord {
  id             String   @id @default(uuid())
  idempotencyKey String   @unique
  requestHash    String
  route          String
  createdAt      DateTime @default(now())

  @@index([createdAt])
}

model SavedCard {
  id          String  @id @default(uuid())
  userId      String
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  last4       String
  brand       String
  expiryMonth Int
  expiryYear  Int
  isDefault   Boolean @default(false)

  @@index([userId])
}

model Invoice {
  id        String   @id @default(uuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId     String?
  payload   Json
  createdAt DateTime @default(now())

  @@index([userId])
}

model Supplier {
  id                    String                       @id @default(uuid())
  userId                String?                      @unique
  user                  User?                        @relation(fields: [userId], references: [id], onDelete: SetNull)
  name                  String
  /// Brand label when multiple branches exist (e.g. "Build It").
  brandName             String?
  /// Branch label (e.g. "Bellville"); paired with brandName for display.
  branchName            String?
  /// Normalized service area / city for matching customer address (optional).
  city                  String?
  businessName          String?
  address               String?
  /** WGS84 — optional pin for storefront / warehouse location (nearest-store UX). */
  latitude              Float?
  longitude             Float?
  phone                 String?
  logo                  String?
  hasDelivery           Boolean                      @default(true)
  deliveryFee           Decimal                      @default(0) @db.Decimal(12, 2)
  products              Json                         @default("[]")
  createdByAdmin        Boolean                      @default(false)
  createdAt             DateTime                     @default(now())
  materialOrders        MaterialOrder[]
  branches              Branch[]

  @@index([createdAt])
}

/// Physical storefront / warehouse under a supplier org (catalog + geo + fees live here).
model Branch {
  id           String                    @id @default(uuid())
  supplierId   String
  supplier     Supplier                  @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  name         String
  address      String?
  /// Normalized service area / city for matching customer address (optional).
  city         String?
  /// Suburb / area within city (optional).
  area         String?
  /// Public contact phone for this branch (customer-facing).
  branchPhone  String?
  /// Public contact email for this branch (customer-facing).
  branchEmail  String?
  latitude     Float?
  longitude    Float?
  hasDelivery  Boolean                   @default(true)
  deliveryFee  Decimal                   @default(0) @db.Decimal(12, 2)
  products     Json                      @default("[]")
  isActive     Boolean                   @default(true)
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  materialOrders        MaterialOrder[]
  inventoryCategories   BranchInventoryCategory[]
  branchUsers           BranchUser[]

  @@index([supplierId])
  @@index([supplierId, isActive])
  @@index([isActive])
}

model BranchUser {
  id        String         @id @default(uuid())
  branchId  String
  branch    Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  email     String         @unique
  password  String
  role      BranchUserRole @default(STAFF)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  branchStaffNotifications BranchStaffNotification[]

  @@index([branchId])
}

model BranchStaffNotification {
  id              String               @id @default(uuid())
  branchUserId    String
  branchUser      BranchUser           @relation(fields: [branchUserId], references: [id], onDelete: Cascade)
  category        NotificationCategory @default(SYSTEM)
  type            String
  title           String
  message         String
  read            Boolean              @default(false)
  metadata        Json?
  materialOrderId String?
  createdAt       DateTime             @default(now())

  @@index([branchUserId])
  @@index([branchUserId, createdAt])
  @@index([category])
}

/// Per-branch catalog categories (normalized lowercase unique per branch)
model BranchInventoryCategory {
  id        String   @id @default(uuid())
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())

  @@unique([branchId, name])
  @@index([branchId])
}

model MaterialOrder {
  id                     String                     @id @default(uuid())
  userId                 String
  supplierId             String
  supplier               Supplier                   @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  branchId               String
  branch                 Branch                     @relation(fields: [branchId], references: [id], onDelete: Restrict)
  /// Job-linked purchase (customer paid from job flow)
  jobId                  String?
  job                    Job?                       @relation("JobMaterialOrders", fields: [jobId], references: [id], onDelete: SetNull)
  providerId             String?
  /// "unpaid" | "paid" — job flow creates as paid
  paymentStatus          String                     @default("paid")
  /// "store_checkout" (standalone cart) | "job_materials" (provider→customer job flow)
  source                 String                     @default("store_checkout")
  fulfillmentStatus      MaterialFulfillmentStatus  @default(PENDING)
  /// Materials subtotal (excludes delivery) — commission base
  materialsSubtotal      Decimal                    @default(0) @db.Decimal(12, 2)
  platformCommission     Decimal                    @default(0) @db.Decimal(12, 2)
  supplierEarning        Decimal                    @default(0) @db.Decimal(12, 2)
  cancelledBy            String?
  cancellationReason     String?
  cancelledAt            DateTime?
  refundStatus           String                     @default("none")
  refundAmount           Decimal                    @default(0) @db.Decimal(12, 2)
  refundProcessedAt      DateTime?
  refundReference        String?
  commissionReversed     Decimal                    @default(0) @db.Decimal(12, 2)
  payload                Json
  createdAt              DateTime                   @default(now())
  trackingSessions     TrackingSession[]
  materialRating       MaterialOrderRating?

  @@index([userId])
  @@index([supplierId])
  @@index([supplierId, fulfillmentStatus])
  @@index([branchId])
  @@index([branchId, fulfillmentStatus])
  @@index([createdAt])
  @@index([jobId])
  @@index([jobId, supplierId])
  @@index([jobId, branchId])
}

/// Customer rating for a completed / confirmed material-order delivery (courier / delivery experience).
model MaterialOrderRating {
  id         String        @id @default(uuid())
  orderId    String        @unique
  order      MaterialOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  providerId String
  provider   Provider      @relation(fields: [providerId], references: [id], onDelete: Cascade)
  rating     Int
  comment    String?
  createdAt  DateTime      @default(now())

  @@index([providerId])
  @@index([createdAt])
}

/// Public driver tracking link (supplier / courier); one active session per order when delivery starts.
model TrackingSession {
  id           String        @id @default(uuid())
  orderId      String
  order        MaterialOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  trackingId   String        @unique
  /// Optional secret for /track/:id?token=… — null on legacy rows (link still works without token).
  accessToken  String?       @unique
  expiresAt    DateTime
  isActive     Boolean       @default(true)
  lastLat      Float?
  lastLng      Float?
  lastPingAt   DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  /// "supplier" | "provider" — who may update live GPS for this session
  currentTrackingSource String @default("supplier")
  /// When true (opt-in via env on create), access token becomes invalid after first successful authenticated GET (public meta)
  accessTokenSingleUse    Boolean   @default(false)
  accessTokenConsumedAt   DateTime?

  @@index([orderId])
  @@index([orderId, isActive])
  @@index([expiresAt])
}

model PromoSpecial {
  id   String @id @default(uuid())
  data Json
}

model DeliveryProvider {
  id            String   @id @default(uuid())
  name          String
  logo          String?
  baseRate      Decimal  @default(0) @db.Decimal(12, 2)
  perKmRate     Decimal  @default(0) @db.Decimal(12, 2)
  estimatedTime String   @default("N/A")
  vehicleType   String?
  numberPlate   String?
  rating        Float?
}

model StoredFile {
  id           String   @id @default(uuid())
  relPath      String
  originalName String
  mimeType     String
  ownerUserId  String?
  type         String?
  createdAt    DateTime @default(now())
}
