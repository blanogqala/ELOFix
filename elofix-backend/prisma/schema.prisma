generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  PROVIDER
  ADMIN
  SUPPLIER
}

enum MaterialFulfillmentStatus {
  PENDING
  ACCEPTED
  PREPARING
  READY
  COLLECTING
  COLLECTED
  AT_DESTINATION
  OUT_FOR_DELIVERY
  COMPLETED
  FAILED
  DELAYED
  CANCELLED
}

enum JobStatus {
  PENDING
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum CategoryStep3Type {
  measurements
  items
  issue
  none
}

enum SuggestionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MaterialRequestStatus {
  draft
  submitted
  paid
}

enum BranchUserRole {
  MANAGER
  STAFF
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

enum NotificationCategory {
  ORDERS
  DELIVERY
  INVENTORY
  SYSTEM
  REFUNDS
  STAFF
}

enum PaymentProvider {
  PAYFAST
  PAYFLEX
  PAYJUSTNOW
}

enum PaymentIntentKind {
  LABOR
  MATERIAL_ORDER
  JOB_STORE_ORDER
  DELIVERY_FEE
}

enum PaymentState {
  PENDING
  PROCESSING
  PAID
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
  DISPUTED
}

enum EscrowStatus {
  NOT_APPLICABLE
  HELD
  PARTIALLY_RELEASED
  FULLY_RELEASED
  REFUNDED
}

enum ProviderPayoutStatus {
  NOT_APPLICABLE
  NONE
  PARTIAL
  COMPLETE
}

enum DisputeStatus {
  OPEN
  UNDER_INVESTIGATION
  RESOLVED
  CLOSED
}

enum DisputeRequestedResolution {
  PROVIDER_RETURN_FIX
  PARTIAL_REFUND
  FULL_REFUND
  REFUND
  OTHER
}

enum DisputeResolutionAction {
  RELEASE_FUNDS
  PARTIAL_REFUND
  FULL_REFUND
  RETURN_PROVIDER
  CLOSE_CASE
}

enum DisputeSenderRole {
  CUSTOMER
  PROVIDER
  ADMIN
}

enum FraudAlertType {
  DUPLICATE_PHONE
  DUPLICATE_SA_ID
  DUPLICATE_COMPANY_REG
  DUPLICATE_BANK_ACCOUNT
  SUSPICIOUS_DEVICE
  HIGH_RISK_PROVIDER
  FLAGGED_CUSTOMER
  SUSPICIOUS_LOGIN
  FAKE_DOCUMENTATION
  UPLOAD_RATE_ABUSE
}

enum FraudSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum FraudAlertStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}

enum ProviderFraudReviewStatus {
  NONE
  PENDING_REVIEW
  CLEARED
  REJECTED
}

enum RefundRecoveryStatus {
  PENDING
  PARTIALLY_RECOVERED
  RECOVERED
  OVERDUE
  WRITTEN_OFF
}

enum ProviderRefundRepaymentStatus {
  SUBMITTED
  CONFIRMED
  REJECTED
}

model User {
  id                  String               @id @default(uuid())
  email               String               @unique
  password            String?
  name                String
  phone               String?
  phoneNormalized     String?
  profileImage        String?
  authProvider        AuthProvider         @default(LOCAL)
  googleId            String?              @unique
  role                Role
  /// Admin moderation — customers (and future roles) suspended from login.
  blocked             Boolean              @default(false)
  blockedReason       String?
  blockedAt           DateTime?
  deletedAt           DateTime?
  createdAt           DateTime             @default(now())
  acceptedTerms                        Boolean   @default(false)
  acceptedPrivacy                      Boolean   @default(false)
  acceptedProviderAgreement            Boolean   @default(false)
  acceptedRefundPolicy                 Boolean   @default(false)
  acceptedSupplierAgreement            Boolean   @default(false)
  acceptedSupplierParticipationPolicy  Boolean   @default(false)
  acceptedAt                           DateTime?
  termsVersion                         String?
  privacyVersion                       String?
  providerAgreementVersion             String?
  refundPolicyVersion                  String?
  supplierAgreementVersion             String?
  supplierParticipationPolicyVersion   String?
  providerProfile     Provider?
  jobsAsCustomer      Job[]                @relation("JobCustomer")
  jobsAsProvider      Job[]                @relation("JobProvider")
  categorySuggestions CategorySuggestion[]
  notifications       Notification[]
  paymentIntents      PaymentIntent[]
  savedCards          SavedCard[]
  invoices            Invoice[]
  sentNotifications   Notification[]       @relation("NotificationSender")
  auditLogs           AuditLog[]
  supplierProfile     Supplier?
  providerReviews     ProviderReview[] @relation("CustomerProviderReviews")
  fraudAlerts         FraudAlert[]     @relation("UserFraudAlerts")
  deviceLinks         DeviceUserLink[]
  passwordResetTokens PasswordResetToken[]
  uploadRateBuckets   UploadRateBucket[]
  uploadRateViolations UploadRateViolation[]

  @@index([phoneNormalized])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model UploadRateBucket {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  String
  windowKey String   @map("window_key")
  count     Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, category, windowKey])
  @@index([userId, category])
  @@map("upload_rate_buckets")
}

model UploadRateViolation {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  String
  limit     Int
  count     Int
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("upload_rate_violations")
}

model Provider {
  id                String    @id @default(uuid())
  userId            String    @unique
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills            String[]
  location          String    @default("UNKNOWN")
  bio               String?
  /// Whole-job totals (Rand) provider reports or system expands from paid labor on jobs
  lowestPaidJobRand  Decimal?  @db.Decimal(12, 2)
  highestPaidJobRand Decimal?  @db.Decimal(12, 2)
  /// Courier / delivery: rate charged per kilometer (Rand). Distance billing comes later.
  deliveryRatePerKmRand Decimal? @db.Decimal(12, 2)
  /// Combined average: job reviews + material-order delivery ratings (see providerAggregateRating sync)
  rating            Float     @default(0)
  totalReviews      Int       @default(0)
  approved          Boolean   @default(false)
  profileCompleted  Boolean   @default(false)
  onboardingStep    Int?
  businessName      String?
  serviceAreas      String[]  @default([])
  laborPricing      Json?
  /// KYC documents JSON. Required keys: idDoc, companyReg, proofOfAddress. Optional: proofOfSkill, certifications.
  /// Each entry: { url, fileId?, originalName?, type?, status?: pending|approved|rejected, feedback? }
  documents         Json?
  settings          Json?
  portfolioImages   String[]  @default([])
  profileImage      String?
  /// Courier vehicle details when delivery skill is enabled
  vehicleType       String?
  numberPlate       String?
  blocked           Boolean   @default(false)
  blockedReason     String?
  blockedAt         DateTime?
  /// Set when auto-blocked for overdue refund debt recovery
  refundDebtBlockedAt DateTime?
  rejectionReason   String?
  rejectedAt        DateTime?
  deletedAt         DateTime?
  reviewSubmittedAt DateTime?
  saIdNumber               String?
  saIdNumberHash           String?                  @unique
  companyRegistrationNumber String?
  companyRegistrationHash  String?
  fraudReviewStatus        ProviderFraudReviewStatus @default(NONE)
  bankVerifiedAt           DateTime?

  workPosts              WorkPost[]
  withdrawalProfile      ProviderWithdrawalProfile?
  withdrawalRequests     WithdrawalRequest[]
  categorySuggestions    CategorySuggestion[]    @relation("ProviderCategorySuggestions")
  earnings               Earning[]
  materialOrderRatings   MaterialOrderRating[]
  providerReviews        ProviderReview[]
  trustScore             ProviderTrustScore?
  fraudAlerts            FraudAlert[]           @relation("ProviderFraudAlerts")
  refundRecoveries       RefundRecovery[]
  refundRepayments       ProviderRefundRepayment[]

  @@index([companyRegistrationHash])
}

model WorkPost {
  id          String   @id @default(uuid())
  providerId  String
  provider    Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  categoryId  String
  title       String
  description String
  images      String[] @default([])
  createdAt   DateTime @default(now())

  @@index([providerId])
}

model CategorySuggestion {
  id         String           @id @default(uuid())
  name       String
  description String?
  icon       String?
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerId String?
  provider   Provider?        @relation("ProviderCategorySuggestions", fields: [providerId], references: [id], onDelete: SetNull)
  status     SuggestionStatus @default(PENDING)
  createdAt  DateTime         @default(now())
  approvedAt DateTime?
  approvedCategoryId String?

  @@index([userId])
  @@index([status])
  @@index([providerId])
  @@index([providerId, status])
  @@index([createdAt])
}

model Job {
  id              String    @id @default(uuid())
  title           String
  category        String    @default("GENERAL")
  location        String    @default("UNKNOWN")
  locationDetails Json?
  description     String
  status          JobStatus @default(PENDING)
  price           Decimal   @db.Decimal(10, 2)
  images          String[]  @default([])
  measurements    Json?
  materials       Json?
  width           Float?
  height          Float?
  length          Float?
  area            Float?
  customerId      String
  customer        User      @relation("JobCustomer", fields: [customerId], references: [id], onDelete: Cascade)
  providerId      String?
  provider        User?     @relation("JobProvider", fields: [providerId], references: [id], onDelete: SetNull)
  createdAt                        DateTime          @default(now())
  meta                             Json?
  /// Optional provider quotation document (PDF/DOC/DOCX/JPG/PNG) — `/api/files/{id}` URL
  quotationFileUrl                 String?
  quotationFileName                String?
  quotationUploadedAt              DateTime?
  laborPaid                        Boolean           @default(false)
  paymentReleased                  Boolean           @default(false)
  /// Gross labor amount charged to customer (at settlement)
  totalPrice                       Decimal?          @db.Decimal(10, 2)
  /// Provider's share (93% of total after 7% commission; half released immediately, half on completion)
  providerAmount                   Decimal?          @db.Decimal(10, 2)
  /// Platform commission (7% of totalPrice)
  commissionAmount                 Decimal           @default(0) @db.Decimal(10, 2)
  /// Cumulative amount released to provider (not including commission)
  releasedAmount                   Decimal           @default(0) @db.Decimal(10, 2)
  isFullyReleased                  Boolean           @default(false)
  /// Prevents double second-tranche release on confirm-completion
  escrowSecondReleaseDone          Boolean           @default(false)
  providerReview                   ProviderReview?
  earnings                         Earning[]
  commissionLedger                 CommissionLedger?
  paystackCharges                  PaystackCharge[]
  paymentIntents                   PaymentIntent[]
  materialRequests                 MaterialRequest[]
  purchaseMaterialOrders           MaterialOrder[] @relation("JobMaterialOrders")
  completionEvidence               JobCompletionEvidence?
  dispute                          JobDispute?
  refundRecoveries                 RefundRecovery[]
}

model MaterialRequest {
  id          String                  @id @default(uuid())
  jobId       String
  job         Job                     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  providerId  String
  customerId  String
  items       Json
  totalAmount Decimal                 @db.Decimal(12, 2)
  status      MaterialRequestStatus   @default(draft)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  @@index([jobId])
  @@index([providerId])
  @@index([status])
  @@index([jobId, status])
  @@index([customerId])
}

/// One row per job after successful labor payment — admin aggregation
model CommissionLedger {
  id         String   @id @default(uuid())
  jobId      String   @unique
  job        Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  amount     Decimal  @db.Decimal(12, 2)
  source     String   @default("labor_payment")
  /// Full gross (customer payment) for reporting
  totalPrice Decimal? @db.Decimal(12, 2)
  currency   String?  @default("ZAR")
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

/// Unified payment ledger (PayFast / Payflex / PayJustNow)
model PaymentIntent {
  id                   String               @id @default(uuid())
  merchantReference    String               @unique
  provider             PaymentProvider
  kind                 PaymentIntentKind
  userId               String
  user                 User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId                String?
  job                  Job?                 @relation(fields: [jobId], references: [id], onDelete: SetNull)
  materialOrderId      String?
  materialOrder        MaterialOrder?       @relation(fields: [materialOrderId], references: [id], onDelete: SetNull)
  amount               Decimal              @db.Decimal(12, 2)
  currency             String               @default("ZAR")
  state                PaymentState         @default(PENDING)
  escrowStatus         EscrowStatus         @default(NOT_APPLICABLE)
  providerPayoutStatus ProviderPayoutStatus @default(NOT_APPLICABLE)
  gatewayTransactionId String?
  gatewayPayload       Json?
  idempotencyKey       String?              @unique
  returnUrl            String?
  cancelUrl            String?
  paidAt               DateTime?
  failedAt             DateTime?
  cancelledAt          DateTime?
  refundedAt           DateTime?
  disputedAt           DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  webhookEvents        PaymentWebhookEvent[]

  @@unique([materialOrderId, kind])
  @@index([jobId])
  @@index([materialOrderId])
  @@index([userId, createdAt])
  @@index([state])
  @@index([provider, gatewayTransactionId])
}

/// Idempotent webhook processing per provider event
model PaymentWebhookEvent {
  id              String          @id @default(uuid())
  provider        PaymentProvider
  externalEventId String
  paymentIntentId String?
  paymentIntent   PaymentIntent?  @relation(fields: [paymentIntentId], references: [id], onDelete: SetNull)
  rawPayload      Json?
  signatureValid  Boolean         @default(false)
  processedAt     DateTime?
  processingError String?
  createdAt       DateTime        @default(now())

  @@unique([provider, externalEventId])
  @@index([paymentIntentId])
}

/// Paystack init / verify state per job+reference
model PaystackCharge {
  id                 String   @id @default(uuid())
  jobId              String
  job                Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  paystackReference  String   @unique
  status             String   @default("pending")
  /// Amount in minor unit currency (ZAR/NGN per Paystack)
  amountZar          Decimal  @default(0) @db.Decimal(12, 2)
  refundedZar        Decimal  @default(0) @db.Decimal(12, 2)
  paystackTransId    String?
  lastRefundMeta     Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([jobId])
  @@index([status])
}

/// Processed Paystack webhook events (idempotency; eventId = Paystack `data.id`)
model PaystackWebhookEvent {
  id        String   @id @default(uuid())
  eventId   String   @unique
  createdAt DateTime @default(now())
}

model Conversation {
  id                String         @id @default(uuid())
  senderId          String
  jobId             String?
  conversationType  String         @default("job")
  createdAt         DateTime       @default(now())
  notifications     Notification[]

  @@index([senderId])
  @@index([jobId])
  @@index([conversationType])
}

model Earning {
  id                    String             @id @default(uuid())
  providerId            String
  provider              Provider           @relation(fields: [providerId], references: [id], onDelete: Cascade)
  jobId                 String?
  job                   Job?               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  amount                Decimal            @db.Decimal(12, 2)
  type                  String
  status                String
  idempotencyKey        String?            @unique
  withdrawalRequestId   String?            @unique
  withdrawalRequest     WithdrawalRequest? @relation(fields: [withdrawalRequestId], references: [id], onDelete: SetNull)
  createdAt             DateTime           @default(now())

  @@index([providerId])
  @@index([jobId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
}

model Category {
  id                 String            @id
  name               String            @unique
  icon               String
  description        String
  requiresMaterials  Boolean           @default(false)
  requiresInspection Boolean           @default(true)
  skills             String[]
  step3Type          CategoryStep3Type
  issueTypes         String[]
  commonItems        Json?
  isActive           Boolean           @default(true)
  sortOrder          Int               @default(0)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
}

model Notification {
  id              String        @id @default(uuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  senderId        String?
  sender          User?         @relation("NotificationSender", fields: [senderId], references: [id], onDelete: SetNull)
  senderName      String?
  senderRole      String?
  type            String
  title           String
  message         String
  read            Boolean       @default(false)
  jobId           String?
  /** Store material-order id for supplier portal notifications (distinct from Job). */
  materialOrderId String?
  /** Branch staff member who sent a support message (admin inbox threading). */
  branchUserId    String?
  /** User id of the support thread partner (admin echo of support_reply). */
  supportTargetUserId String?
  conversationId  String?
  conversation    Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  notificationCategory NotificationCategory @default(SYSTEM)
  /** Optional idempotency key — unique per user when set. */
  dedupeKey       String?
  createdAt       DateTime      @default(now())
  deliveryOutbox    NotificationDeliveryOutbox[]

  @@unique([userId, dedupeKey])
  @@index([userId])
  @@index([userId, createdAt])
  @@index([senderId])
  @@index([branchUserId])
  @@index([conversationId])
  @@index([notificationCategory])
}

enum NotificationDeliveryChannel {
  SOCKET
  EMAIL
}

enum NotificationDeliveryStatus {
  PENDING
  SENT
  FAILED
  DEAD
}

model NotificationDeliveryOutbox {
  id             String                     @id @default(uuid())
  notificationId String?
  notification   Notification?              @relation(fields: [notificationId], references: [id], onDelete: SetNull)
  channel        NotificationDeliveryChannel
  payload        Json
  status         NotificationDeliveryStatus @default(PENDING)
  attempts       Int                        @default(0)
  maxAttempts    Int                        @default(5)
  nextAttemptAt  DateTime                   @default(now())
  lastError      String?
  sentAt         DateTime?
  createdAt      DateTime                   @default(now())

  @@index([status, nextAttemptAt])
  @@index([notificationId])
}

model ProviderReview {
  id                   String   @id @default(uuid())
  rating               Int
  comment              String?
  images               String[] @default([])
  videos               String[] @default([])
  disputeImages        String[] @default([])
  disputeVideos        String[] @default([])
  wasDisputed          Boolean  @default(false)
  resolvedAfterDispute Boolean  @default(false)
  customerId           String
  customer             User     @relation("CustomerProviderReviews", fields: [customerId], references: [id], onDelete: Cascade)
  providerId           String
  provider             Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  jobId                String   @unique
  job                  Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  createdAt            DateTime @default(now())

  @@index([providerId])
  @@index([customerId])
  @@index([jobId])
  @@index([createdAt])
}

model ProviderWithdrawalProfile {
  id             String   @id @default(uuid())
  providerId     String   @unique
  provider       Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  bankName       String
  accountNumber  String
  accountHolder  String
  branchCode     String
  bankAccountHash String?
  updatedAt      DateTime @updatedAt

  @@index([bankAccountHash])
}

model WithdrawalRequest {
  id               String    @id @default(uuid())
  providerId       String
  provider         Provider  @relation(fields: [providerId], references: [id], onDelete: Cascade)
  amount           Decimal   @db.Decimal(12, 2)
  status           String    @default("pending")
  idempotencyKey   String?   @unique
  createdAt        DateTime  @default(now())
  debitEarning     Earning?

  @@index([providerId])
  @@index([status])
  @@index([createdAt])
}

model JobCompletionEvidence {
  id                String    @id @default(uuid())
  jobId             String    @unique
  job               Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  customerId        String
  providerId        String
  rating            Int?
  review            String?
  images            String[]  @default([])
  videos            String[]  @default([])
  verified          Boolean   @default(true)
  autoCompleted     Boolean   @default(false)
  jobCategory       String    @default("GENERAL")
  confirmedAt       DateTime  @default(now())
  paymentReleasedAt DateTime?

  @@index([providerId])
  @@index([customerId])
  @@index([confirmedAt])
}

model JobDispute {
  id                  String                     @id @default(uuid())
  jobId               String                     @unique
  job                 Job                        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  customerId          String
  providerId          String
  status              DisputeStatus              @default(OPEN)
  requestedResolution DisputeRequestedResolution
  customerComment     String
  otherResolutionDetail String?
  customerImages      String[]                   @default([])
  customerVideos      String[]                   @default([])
  providerComment     String?
  providerImages      String[]                   @default([])
  providerVideos      String[]                   @default([])
  adminNotes          String?
  openedAt            DateTime                   @default(now())
  resolvedAt          DateTime?
  messages            DisputeMessage[]
  resolutionLogs      DisputeResolutionLog[]
  rounds              JobDisputeRound[]
  refundRecoveries    RefundRecovery[]

  @@index([status])
  @@index([providerId])
  @@index([customerId])
  @@index([openedAt])
}

model JobDisputeRound {
  id                    String                     @id @default(uuid())
  disputeId             String
  dispute               JobDispute                 @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  roundNumber           Int
  status                DisputeStatus              @default(OPEN)
  requestedResolution   DisputeRequestedResolution
  customerComment       String
  otherResolutionDetail String?
  customerImages        String[]                   @default([])
  customerVideos        String[]                   @default([])
  providerComment       String?
  providerImages        String[]                   @default([])
  providerVideos        String[]                   @default([])
  resolutionAction      DisputeResolutionAction?
  resolutionNotes       String?
  openedAt              DateTime                   @default(now())
  resolvedAt            DateTime?

  @@unique([disputeId, roundNumber])
  @@index([disputeId, openedAt])
}

model DisputeMessage {
  id          String            @id @default(uuid())
  disputeId   String
  dispute     JobDispute        @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  senderId    String
  senderRole  DisputeSenderRole
  body        String
  attachments String[]          @default([])
  createdAt   DateTime          @default(now())

  @@index([disputeId, createdAt])
}

model DisputeResolutionLog {
  id        String                  @id @default(uuid())
  disputeId String
  dispute   JobDispute              @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  adminId   String
  action    DisputeResolutionAction
  amount    Decimal?                @db.Decimal(12, 2)
  notes     String?
  createdAt DateTime                @default(now())

  @@index([disputeId])
  @@index([adminId])
  @@index([createdAt])
}

model ProviderTrustScore {
  id               String   @id @default(uuid())
  providerId       String   @unique
  provider         Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  score            Int      @default(100)
  disputeCount     Int      @default(0)
  refundCount      Int      @default(0)
  completedJobs    Int      @default(0)
  positiveReviews  Int      @default(0)
  lastCalculatedAt DateTime @default(now())
  history          Json     @default("[]")

  @@index([score])
}

model FraudAlert {
  id          String           @id @default(uuid())
  userId      String?
  user        User?            @relation("UserFraudAlerts", fields: [userId], references: [id], onDelete: SetNull)
  providerId  String?
  provider    Provider?        @relation("ProviderFraudAlerts", fields: [providerId], references: [id], onDelete: SetNull)
  alertType   FraudAlertType
  severity    FraudSeverity    @default(MEDIUM)
  status      FraudAlertStatus @default(OPEN)
  description String
  metadata    Json?
  reviewedBy  String?
  reviewedAt  DateTime?
  createdAt   DateTime         @default(now())

  @@index([alertType])
  @@index([severity])
  @@index([status])
  @@index([userId])
  @@index([providerId])
  @@index([createdAt])
}

model DeviceProfile {
  id                 String           @id @default(uuid())
  browserFingerprint String?
  deviceFingerprint  String           @unique
  ipAddress          String?
  os                 String?
  country            String?
  city               String?
  userAgent          String?
  firstSeenAt        DateTime         @default(now())
  lastSeenAt         DateTime         @default(now())
  userLinks          DeviceUserLink[]

  @@index([lastSeenAt])
}

model DeviceUserLink {
  id              String        @id @default(uuid())
  deviceProfileId String
  deviceProfile   DeviceProfile @relation(fields: [deviceProfileId], references: [id], onDelete: Cascade)
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role            Role
  firstLoginAt    DateTime      @default(now())
  lastLoginAt     DateTime      @default(now())
  loginCount      Int           @default(1)

  @@unique([deviceProfileId, userId])
  @@index([userId])
  @@index([deviceProfileId])
}

model AuditLog {
  id                String   @id @default(uuid())
  userId            String?
  user              User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  actorType         String   @default("USER")
  action            String
  entityType        String?
  entityId          String?
  oldValue          Json?
  newValue          Json?
  ipAddress         String?
  deviceFingerprint String?
  metadata          Json?
  createdAt         DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model IdempotencyRecord {
  id             String   @id @default(uuid())
  idempotencyKey String   @unique
  requestHash    String
  route          String
  createdAt      DateTime @default(now())

  @@index([createdAt])
}

model SavedCard {
  id          String  @id @default(uuid())
  userId      String
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  last4       String
  brand       String
  expiryMonth Int
  expiryYear  Int
  isDefault   Boolean @default(false)

  @@index([userId])
}

model Invoice {
  id        String   @id @default(uuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId     String?
  payload   Json
  createdAt DateTime @default(now())

  @@index([userId])
}

model Supplier {
  id                    String                       @id @default(uuid())
  userId                String?                      @unique
  user                  User?                        @relation(fields: [userId], references: [id], onDelete: SetNull)
  name                  String
  /// Brand label when multiple branches exist (e.g. "Build It").
  brandName             String?
  /// Branch label (e.g. "Bellville"); paired with brandName for display.
  branchName            String?
  /// Normalized service area / city for matching customer address (optional).
  city                  String?
  businessName          String?
  address               String?
  /** WGS84 — optional pin for storefront / warehouse location (nearest-store UX). */
  latitude              Float?
  longitude             Float?
  phone                 String?
  logo                  String?
  hasDelivery           Boolean                      @default(true)
  deliveryFee           Decimal                      @default(0) @db.Decimal(12, 2)
  products              Json                         @default("[]")
  createdByAdmin        Boolean                      @default(false)
  createdAt             DateTime                     @default(now())
  materialOrders        MaterialOrder[]
  branches              Branch[]

  @@index([createdAt])
}

/// Physical storefront / warehouse under a supplier org (catalog + geo + fees live here).
model Branch {
  id           String                    @id @default(uuid())
  supplierId   String
  supplier     Supplier                  @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  name         String
  address      String?
  /// Normalized service area / city for matching customer address (optional).
  city         String?
  /// Suburb / area within city (optional).
  area         String?
  /// Public contact phone for this branch (customer-facing).
  branchPhone  String?
  /// Public contact email for this branch (customer-facing).
  branchEmail  String?
  latitude     Float?
  longitude    Float?
  hasDelivery  Boolean                   @default(true)
  deliveryFee  Decimal                   @default(0) @db.Decimal(12, 2)
  products     Json                      @default("[]")
  isActive     Boolean                   @default(true)
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  materialOrders        MaterialOrder[]
  inventoryCategories   BranchInventoryCategory[]
  branchUsers           BranchUser[]
  withdrawalProfile     BranchWithdrawalProfile?
  withdrawalRequests    BranchWithdrawalRequest[]

  @@index([supplierId])
  @@index([supplierId, isActive])
  @@index([isActive])
}

model BranchWithdrawalProfile {
  id              String   @id @default(uuid())
  branchId        String   @unique
  branch          Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  bankName        String
  accountNumber   String
  accountHolder   String
  branchCode      String
  bankAccountHash String?
  updatedAt       DateTime @updatedAt

  @@index([bankAccountHash])
}

model BranchWithdrawalRequest {
  id             String   @id @default(uuid())
  branchId       String
  branch         Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  amount         Decimal  @db.Decimal(12, 2)
  status         String   @default("pending")
  idempotencyKey String?  @unique
  createdAt      DateTime @default(now())

  @@index([branchId])
  @@index([status])
  @@index([createdAt])
}

model BranchUser {
  id                                  String         @id @default(uuid())
  branchId                            String
  branch                              Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  email                               String         @unique
  password                            String
  role                                BranchUserRole @default(STAFF)
  acceptedTerms                       Boolean        @default(false)
  acceptedPrivacy                     Boolean        @default(false)
  acceptedSupplierAgreement           Boolean        @default(false)
  acceptedSupplierParticipationPolicy Boolean        @default(false)
  acceptedAt                          DateTime?
  termsVersion                        String?
  privacyVersion                      String?
  supplierAgreementVersion            String?
  supplierParticipationPolicyVersion  String?
  createdAt                           DateTime       @default(now())
  updatedAt                           DateTime       @updatedAt

  branchStaffNotifications BranchStaffNotification[]

  @@index([branchId])
}

model BranchStaffNotification {
  id              String               @id @default(uuid())
  branchUserId    String
  branchUser      BranchUser           @relation(fields: [branchUserId], references: [id], onDelete: Cascade)
  category        NotificationCategory @default(SYSTEM)
  type            String
  title           String
  message         String
  read            Boolean              @default(false)
  metadata        Json?
  materialOrderId String?
  dedupeKey       String?
  createdAt       DateTime             @default(now())

  @@unique([branchUserId, dedupeKey])
  @@index([branchUserId])
  @@index([branchUserId, createdAt])
  @@index([category])
}

/// Per-branch catalog categories (normalized lowercase unique per branch)
model BranchInventoryCategory {
  id        String   @id @default(uuid())
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())

  @@unique([branchId, name])
  @@index([branchId])
}

model MaterialOrder {
  id                     String                     @id @default(uuid())
  userId                 String
  supplierId             String
  supplier               Supplier                   @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  branchId               String
  branch                 Branch                     @relation(fields: [branchId], references: [id], onDelete: Restrict)
  /// Job-linked purchase (customer paid from job flow)
  jobId                  String?
  job                    Job?                       @relation("JobMaterialOrders", fields: [jobId], references: [id], onDelete: SetNull)
  providerId             String?
  /// "unpaid" | "paid"
  paymentStatus          String                     @default("unpaid")
  paymentIntents         PaymentIntent[]
  /// "store_checkout" (standalone cart) | "job_materials" (provider→customer job flow)
  source                 String                     @default("store_checkout")
  fulfillmentStatus      MaterialFulfillmentStatus  @default(PENDING)
  /// Materials subtotal (excludes delivery) — commission base
  materialsSubtotal      Decimal                    @default(0) @db.Decimal(12, 2)
  platformCommission     Decimal                    @default(0) @db.Decimal(12, 2)
  supplierEarning        Decimal                    @default(0) @db.Decimal(12, 2)
  cancelledBy            String?
  cancellationReason     String?
  cancelledAt            DateTime?
  refundStatus           String                     @default("none")
  refundAmount           Decimal                    @default(0) @db.Decimal(12, 2)
  refundProcessedAt      DateTime?
  refundReference        String?
  commissionReversed     Decimal                    @default(0) @db.Decimal(12, 2)
  payload                Json
  createdAt              DateTime                   @default(now())
  trackingSessions     TrackingSession[]
  materialRating       MaterialOrderRating?

  @@index([userId])
  @@index([supplierId])
  @@index([supplierId, fulfillmentStatus])
  @@index([branchId])
  @@index([branchId, fulfillmentStatus])
  @@index([createdAt])
  @@index([jobId])
  @@index([jobId, supplierId])
  @@index([jobId, branchId])
}

/// Standalone customer delivery request (moving / courier without material purchase).
model DeliveryRequest {
  id                String                    @id @default(uuid())
  customerId        String
  courierId         String?
  source            String                    @default("direct")
  materialOrderId   String?                   @unique
  jobId             String?
  category          String
  description       String?
  photos            String[]                  @default([])
  items             Json
  collectionPoint   Json
  destinationPoint  Json
  status            String                    @default("pending_quote")
  quotedFee         Decimal?                  @db.Decimal(12, 2)
  quoteNote         String?
  fulfillmentStatus MaterialFulfillmentStatus @default(PENDING)
  payload           Json?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  trackingSessions  TrackingSession[]

  @@index([customerId])
  @@index([courierId])
  @@index([status])
  @@index([createdAt])
}

/// Customer rating for a completed / confirmed material-order delivery (courier / delivery experience).
model MaterialOrderRating {
  id         String        @id @default(uuid())
  orderId    String        @unique
  order      MaterialOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  providerId String
  provider   Provider      @relation(fields: [providerId], references: [id], onDelete: Cascade)
  rating     Int
  comment    String?
  createdAt  DateTime      @default(now())

  @@index([providerId])
  @@index([createdAt])
}

/// Public driver tracking link (supplier / courier); one active session per order when delivery starts.
model TrackingSession {
  id                  String           @id @default(uuid())
  orderId             String?
  order               MaterialOrder?   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  deliveryRequestId   String?
  deliveryRequest     DeliveryRequest? @relation(fields: [deliveryRequestId], references: [id], onDelete: Cascade)
  trackingId          String           @unique
  /// Optional secret for /track/:id?token=… — null on legacy rows (link still works without token).
  accessToken  String?       @unique
  expiresAt    DateTime
  isActive     Boolean       @default(true)
  lastLat      Float?
  lastLng      Float?
  lastPingAt   DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  /// "supplier" | "provider" — who may update live GPS for this session
  currentTrackingSource String @default("supplier")
  /// When true (opt-in via env on create), access token becomes invalid after first successful authenticated GET (public meta)
  accessTokenSingleUse    Boolean   @default(false)
  accessTokenConsumedAt   DateTime?

  @@index([orderId])
  @@index([orderId, isActive])
  @@index([deliveryRequestId])
  @@index([deliveryRequestId, isActive])
  @@index([expiresAt])
}

model PromoSpecial {
  id   String @id @default(uuid())
  data Json
}

model DeliveryProvider {
  id            String   @id @default(uuid())
  name          String
  logo          String?
  baseRate      Decimal  @default(0) @db.Decimal(12, 2)
  perKmRate     Decimal  @default(0) @db.Decimal(12, 2)
  estimatedTime String   @default("N/A")
  vehicleType   String?
  numberPlate   String?
  rating        Float?
}

model StoredFile {
  id           String   @id @default(uuid())
  relPath      String
  originalName String
  mimeType     String
  ownerUserId  String?
  type         String?
  createdAt    DateTime @default(now())
}

/// Customer-facing staged refund obligation — provider-funded portion recovered over time.
model RefundRecovery {
  id               String               @id @default(uuid())
  providerId       String
  provider         Provider             @relation(fields: [providerId], references: [id], onDelete: Cascade)
  customerId       String
  jobId            String?
  job              Job?                 @relation(fields: [jobId], references: [id], onDelete: SetNull)
  disputeId        String?
  dispute          JobDispute?          @relation(fields: [disputeId], references: [id], onDelete: SetNull)
  totalPending     Decimal              @db.Decimal(12, 2)
  recoveredAmount  Decimal              @default(0) @db.Decimal(12, 2)
  status           RefundRecoveryStatus @default(PENDING)
  dueAt            DateTime
  reference        String
  legalActionAt    DateTime?
  reminder7SentAt    DateTime?
  reminder1SentAt    DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([providerId])
  @@index([customerId])
  @@index([jobId])
  @@index([status])
  @@index([dueAt])
}

/// Provider out-of-pocket bank transfer toward refund debt — admin confirms.
model ProviderRefundRepayment {
  id          String                        @id @default(uuid())
  providerId  String
  provider    Provider                      @relation(fields: [providerId], references: [id], onDelete: Cascade)
  amount      Decimal                       @db.Decimal(12, 2)
  reference   String
  proofUrl    String?
  status      ProviderRefundRepaymentStatus   @default(SUBMITTED)
  reviewedBy  String?
  reviewedAt  DateTime?
  adminNote   String?
  createdAt   DateTime                      @default(now())

  @@index([providerId])
  @@index([status])
  @@index([createdAt])
}
