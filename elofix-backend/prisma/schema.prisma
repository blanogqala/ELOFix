generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  PROVIDER
  ADMIN
}

enum JobStatus {
  PENDING
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum CategoryStep3Type {
  measurements
  items
  issue
}

enum SuggestionStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id                  String               @id @default(uuid())
  email               String               @unique
  password            String
  name                String
  phone               String?
  role                Role
  createdAt           DateTime             @default(now())
  providerProfile     Provider?
  jobsAsCustomer      Job[]                @relation("JobCustomer")
  jobsAsProvider      Job[]                @relation("JobProvider")
  categorySuggestions CategorySuggestion[]
  notifications       Notification[]
  savedCards          SavedCard[]
  invoices            Invoice[]
  sentNotifications   Notification[]       @relation("NotificationSender")
  auditLogs           AuditLog[]
}

model Provider {
  id                String    @id @default(uuid())
  userId            String    @unique
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills            String[]
  location          String    @default("UNKNOWN")
  bio               String?
  rating            Float     @default(0)
  approved          Boolean   @default(false)
  profileCompleted  Boolean   @default(false)
  onboardingStep    Int?
  businessName      String?
  serviceAreas      String[]  @default([])
  laborPricing      Json?
  documents         Json?
  settings          Json?
  portfolioImages   String[]  @default([])
  profileImage      String?
  blocked           Boolean   @default(false)
  rejectionReason   String?
  rejectedAt        DateTime?
  deletedAt         DateTime?
  reviewSubmittedAt DateTime?

  workPosts              WorkPost[]
  withdrawalProfile      ProviderWithdrawalProfile?
  withdrawalRequests     WithdrawalRequest[]
  categorySuggestions    CategorySuggestion[]    @relation("ProviderCategorySuggestions")
  earnings               Earning[]
}

model WorkPost {
  id          String   @id @default(uuid())
  providerId  String
  provider    Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  categoryId  String
  title       String
  description String
  images      String[] @default([])
  createdAt   DateTime @default(now())

  @@index([providerId])
}

model CategorySuggestion {
  id         String           @id @default(uuid())
  name       String
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerId String?
  provider   Provider?        @relation("ProviderCategorySuggestions", fields: [providerId], references: [id], onDelete: SetNull)
  status     SuggestionStatus @default(PENDING)
  createdAt  DateTime         @default(now())

  @@index([userId])
  @@index([status])
  @@index([providerId])
}

model Job {
  id              String    @id @default(uuid())
  title           String
  category        String    @default("GENERAL")
  location        String    @default("UNKNOWN")
  locationDetails Json?
  description     String
  status          JobStatus @default(PENDING)
  price           Decimal   @db.Decimal(10, 2)
  images          String[]  @default([])
  measurements    Json?
  materials       Json?
  width           Float?
  height          Float?
  length          Float?
  area            Float?
  customerId      String
  customer        User      @relation("JobCustomer", fields: [customerId], references: [id], onDelete: Cascade)
  providerId      String?
  provider        User?     @relation("JobProvider", fields: [providerId], references: [id], onDelete: SetNull)
  createdAt       DateTime  @default(now())
  meta            Json?
  laborPaid       Boolean   @default(false)
  paymentReleased Boolean   @default(false)
  review          Review?
  earnings        Earning[]
}

model Conversation {
  id                String         @id @default(uuid())
  senderId          String
  jobId             String?
  conversationType  String         @default("job")
  createdAt         DateTime       @default(now())
  notifications     Notification[]

  @@index([senderId])
  @@index([jobId])
  @@index([conversationType])
}

model Earning {
  id                    String             @id @default(uuid())
  providerId            String
  provider              Provider           @relation(fields: [providerId], references: [id], onDelete: Cascade)
  jobId                 String?
  job                   Job?               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  amount                Decimal            @db.Decimal(12, 2)
  type                  String
  status                String
  idempotencyKey        String?            @unique
  withdrawalRequestId   String?            @unique
  withdrawalRequest     WithdrawalRequest? @relation(fields: [withdrawalRequestId], references: [id], onDelete: SetNull)
  createdAt             DateTime           @default(now())

  @@index([providerId])
  @@index([jobId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
}

model Category {
  id                 String            @id
  name               String            @unique
  icon               String
  description        String
  requiresMaterials  Boolean           @default(false)
  requiresInspection Boolean           @default(true)
  skills             String[]
  step3Type          CategoryStep3Type
  issueTypes         String[]
  commonItems        Json?
  isActive           Boolean           @default(true)
  sortOrder          Int               @default(0)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
}

model Notification {
  id              String        @id @default(uuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  senderId        String?
  sender          User?         @relation("NotificationSender", fields: [senderId], references: [id], onDelete: SetNull)
  senderName      String?
  senderRole      String?
  type            String
  title           String
  message         String
  read            Boolean       @default(false)
  jobId           String?
  conversationId  String?
  conversation    Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  createdAt       DateTime      @default(now())

  @@index([userId])
  @@index([userId, createdAt])
  @@index([senderId])
  @@index([conversationId])
}

model Review {
  id        String   @id @default(uuid())
  jobId     String   @unique
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  @@index([jobId])
}

model ProviderWithdrawalProfile {
  id             String   @id @default(uuid())
  providerId     String   @unique
  provider       Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  bankName       String
  accountNumber  String
  accountHolder  String
  branchCode     String
  updatedAt      DateTime @updatedAt
}

model WithdrawalRequest {
  id               String    @id @default(uuid())
  providerId       String
  provider         Provider  @relation(fields: [providerId], references: [id], onDelete: Cascade)
  amount           Decimal   @db.Decimal(12, 2)
  status           String    @default("pending")
  idempotencyKey   String?   @unique
  createdAt        DateTime  @default(now())
  debitEarning     Earning?

  @@index([providerId])
  @@index([status])
  @@index([createdAt])
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model IdempotencyRecord {
  id             String   @id @default(uuid())
  idempotencyKey String   @unique
  requestHash    String
  route          String
  createdAt      DateTime @default(now())

  @@index([createdAt])
}

model SavedCard {
  id          String  @id @default(uuid())
  userId      String
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  last4       String
  brand       String
  expiryMonth Int
  expiryYear  Int
  isDefault   Boolean @default(false)

  @@index([userId])
}

model Invoice {
  id        String   @id @default(uuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId     String?
  payload   Json
  createdAt DateTime @default(now())

  @@index([userId])
}

model Supplier {
  id          String  @id @default(uuid())
  name        String
  logo        String?
  hasDelivery Boolean @default(true)
  deliveryFee Decimal @default(0) @db.Decimal(12, 2)
  products    Json    @default("[]")
}

model MaterialOrder {
  id        String   @id @default(uuid())
  userId    String
  payload   Json
  createdAt DateTime @default(now())

  @@index([userId])
}

model PromoSpecial {
  id   String @id @default(uuid())
  data Json
}

model DeliveryProvider {
  id            String   @id @default(uuid())
  name          String
  logo          String?
  baseRate      Decimal  @default(0) @db.Decimal(12, 2)
  perKmRate     Decimal  @default(0) @db.Decimal(12, 2)
  estimatedTime String   @default("N/A")
  vehicleType   String?
  numberPlate   String?
  rating        Float?
}

model StoredFile {
  id           String   @id @default(uuid())
  relPath      String
  originalName String
  mimeType     String
  ownerUserId  String?
  type         String?
  createdAt    DateTime @default(now())
}
